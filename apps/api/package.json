{
  "name": "@workflow/api",
  "version": "0.0.0",
  "private": true,
  "description": "API Nest.js : stockage et exécution des workflows.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "lint": "eslint src",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ../../node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@turf/convex": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "@workflow/shared": "*",
    "better-sqlite3": "^12.11.1",
    "geotiff": "^3.0.5",
    "proj4": "^2.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/geojson": "^7946.0.16",
    "prisma": "^7.10.0"
  }
}
