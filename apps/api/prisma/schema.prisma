// Schéma Prisma de l'API. L'URL de connexion est définie dans prisma.config.ts (Prisma 7).
//
// Modèle métier : Client → Parcelle → Campagne → ExecutionWorkflow → Decision
//                                        └→ DonneeBrute (données collectées, immuables)
//
// Suppressions : `onDelete: Restrict` partout (sauf ExecutionNoeud, qui suit son exécution). On ne supprime jamais un parent qui a des
// enfants, pour ne pas perdre la traçabilité des décisions.
//
// Statuts : stockés en texte, les valeurs autorisées sont définies par les schémas Zod
// de @workflow/shared (statutsExecution, statutsDecision, typesDonneeBrute).
//
// ATTENTION : la migration `modele_metier` ajoute des triggers SQLite qui rendent immuables
// les DonneeBrute et le snapshot des ExecutionWorkflow. Si une future migration reconstruit
// ces tables (Prisma le fait sur SQLite pour certains changements de colonnes), elle doit
// recréer ces triggers.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id               String     @id @default(cuid())
  nom              String
  email            String?
  telephone        String?
  /// SHA-256 du jeton du lien d'accès à l'espace client (le jeton n'est jamais stocké).
  jetonAccesHash   String?    @unique
  jetonAccesCreeLe DateTime?
  parcelles        Parcelle[]
  creeLe           DateTime   @default(now())
  modifieLe        DateTime   @updatedAt
}

model Parcelle {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  nom       String
  /// GeoJSON Polygon ou MultiPolygon, WGS84 (voir geometrieParcelleSchema).
  geometrie Json
  /// Calculée par l'API à partir de la géométrie.
  surfaceHa Float
  campagnes Campagne[]
  tachesLot TacheLot[]
  creeLe    DateTime   @default(now())
  modifieLe DateTime   @updatedAt

  @@index([clientId])
}

model Campagne {
  id            String              @id @default(cuid())
  parcelleId    String
  parcelle      Parcelle            @relation(fields: [parcelleId], references: [id], onDelete: Restrict)
  nom           String
  /// Culture du référentiel (null : culture saisie librement dans `culture`).
  cultureId     String?
  cultureRef    Culture?            @relation(fields: [cultureId], references: [id], onDelete: Restrict)
  culture       String?
  /// Date calendaire AAAA-MM-JJ.
  dateDebut     String
  /// Date calendaire AAAA-MM-JJ ; null tant que la campagne est en cours.
  dateFin       String?
  donneesBrutes DonneeBrute[]
  executions    ExecutionWorkflow[]
  tachesLot     TacheLot[]
  creeLe        DateTime            @default(now())
  modifieLe     DateTime            @updatedAt

  @@index([parcelleId])
  @@index([cultureId])
}

/// Donnée collectée (GPS, formulaire terrain, métadonnées Sentinel-2). Immuable (triggers).
model DonneeBrute {
  id         String   @id @default(cuid())
  campagneId String
  campagne   Campagne @relation(fields: [campagneId], references: [id], onDelete: Restrict)
  /// gps | formulaire_terrain | image_sentinel2
  type       String
  source     String
  contenu    Json
  /// SHA-256 du contenu sérialisé canoniquement.
  empreinte  String
  importeeLe DateTime @default(now())

  @@index([campagneId, type])
}

/// Exécution d'un workflow. snapshot, empreinteSnapshot, version, workflowId et campagneId sont figés (trigger).
model ExecutionWorkflow {
  id                String           @id @default(cuid())
  campagneId        String
  campagne          Campagne         @relation(fields: [campagneId], references: [id], onDelete: Restrict)
  workflowId        String
  /// Numéro d'exécution de ce workflow sur cette campagne : 1, 2, 3…
  version           Int
  /// Copie du workflow exécuté (voir workflowSnapshotSchema).
  snapshot          Json
  empreinteSnapshot String
  /// en_attente | en_cours | terminee | echouee
  statut            String           @default("en_attente")
  erreur            String?
  demarreeLe        DateTime?
  termineeLe        DateTime?
  noeuds            ExecutionNoeud[]
  decisions         Decision[]
  tachesLot         TacheLot[]
  creeLe            DateTime         @default(now())
  modifieLe         DateTime         @updatedAt

  @@unique([campagneId, workflowId, version])
}

/// État d'un nœud du snapshot pendant l'exécution. Supprimé avec son exécution.
model ExecutionNoeud {
  id          String            @id @default(cuid())
  executionId String
  execution   ExecutionWorkflow @relation(fields: [executionId], references: [id], onDelete: Cascade)
  /// Identifiant de l'instance du nœud dans le snapshot.
  noeudId     String
  /// en_attente | en_cours | ok | erreur
  statut      String            @default("en_attente")
  /// Valeurs produites par port de sortie.
  sorties     Json?
  erreur      String?
  demarreLe   DateTime?
  termineLe   DateTime?

  @@unique([executionId, noeudId])
}

model Decision {
  id             String            @id @default(cuid())
  executionId    String
  execution      ExecutionWorkflow @relation(fields: [executionId], references: [id], onDelete: Restrict)
  /// Identifiants des nœuds du snapshot qui ont produit la décision (tableau JSON).
  noeudIds       Json
  explication    String
  /// Action conseillée par la règle métier (null pour une décision saisie à la main).
  recommandation String?
  /// basse | normale | haute
  priorite       String?
  /// Données qui ont motivé la décision : indicateur, valeur, condition, nœud source.
  donnees        Json?
  /// brouillon | validé | envoyé | appliqué | non_appliqué | rejeté
  /// (envoyé, appliqué et non_appliqué sont visibles dans l'espace client)
  statut         String            @default("brouillon")
  valideeLe      DateTime?
  envoyeeLe      DateTime?
  rejeteeLe      DateTime?
  /// Raison du rejet, usage interne.
  motifRejet     String?

  /// Volet « prévu », renseigné avant l'envoi. Date au format AAAA-MM-JJ, coût en euros.
  prevuProduit    String?
  prevuDose       Float?
  prevuUniteDose  String?
  prevuDate       String?
  prevuCoutEstime Float?

  /// Volet « réel », saisi après application (reelDate non nulle = réel saisi).
  reelProduit   String?
  reelDose      Float?
  reelUniteDose String?
  reelDate      String?
  reelCout      Float?
  reelPhoto     Bytes?
  /// image/jpeg | image/png | image/webp
  reelPhotoType String?

  appliqueeLe            DateTime?
  /// equipe | espace_client
  applicationDeclareePar String?
  nonAppliqueeLe         DateTime?
  /// Raison de la non-application, usage interne.
  motifNonApplication    String?

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([executionId, statut])
}

/// Modèle de workflow chargeable dans l'éditeur. Les modèles prédéfinis (code non nul)
/// sont synchronisés depuis le code au démarrage de l'API et ne sont pas modifiables.
model ModeleWorkflow {
  id               String   @id @default(cuid())
  code             String?  @unique
  nom              String   @unique
  description      String   @default("")
  predefini        Boolean  @default(false)
  /// Culture visée (null : modèle générique).
  cultureId        String?
  culture          Culture? @relation(fields: [cultureId], references: [id], onDelete: Restrict)
  /// Paramètres par défaut (seuils NDVI, doses de référence, tarifs), déjà appliqués au graphe.
  parametresDefaut Json?
  /// Graphe : nœuds (type, paramètres, position) et connexions (voir grapheWorkflowSchema).
  graphe           Json
  lots             Lot[]
  creeLe           DateTime @default(now())
  modifieLe        DateTime @updatedAt
}

/// Culture du référentiel : cycle et stades phénologiques (JSON, voir stadePhenologiqueSchema).
/// Les valeurs d'exemple sont marquées aValider : à faire valider par un agronome.
model Culture {
  id              String           @id @default(cuid())
  code            String           @unique
  nom             String           @unique
  nomScientifique String?
  cycleJours      Int
  stades          Json
  aValider        Boolean          @default(true)
  noteValidation  String           @default("")
  campagnes       Campagne[]
  modeles         ModeleWorkflow[]
  creeLe          DateTime         @default(now())
  modifieLe       DateTime         @updatedAt
}

/// Exécution par lot : un modèle lancé sur plusieurs parcelles. Le graphe est copié à la
/// création (le lot n'est pas affecté si le modèle change ou disparaît ensuite).
model Lot {
  id         String          @id @default(cuid())
  nom        String
  modeleId   String?
  modele     ModeleWorkflow? @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  modeleNom  String
  /// Identité des exécutions créées (versionnées par campagne).
  workflowId String
  /// Graphe du modèle (nœuds, connexions, variables) au moment du lancement.
  graphe     Json
  /// Valeurs communes des variables (les variables « parcelle » sont remplies par tâche).
  valeurs    Json
  taches     TacheLot[]
  creeLe     DateTime        @default(now())
  modifieLe  DateTime        @updatedAt
}

/// Tâche de la file : une parcelle d'un lot. File en base (SQLite), traitée par le travailleur
/// de l'API avec relances espacées ; un échec n'affecte pas les autres tâches.
model TacheLot {
  id                   String             @id @default(cuid())
  lotId                String
  lot                  Lot                @relation(fields: [lotId], references: [id], onDelete: Cascade)
  parcelleId           String
  parcelle             Parcelle           @relation(fields: [parcelleId], references: [id], onDelete: Restrict)
  /// Campagne la plus récente de la parcelle au lancement (null : aucune, échec immédiat).
  campagneId           String?
  campagne             Campagne?          @relation(fields: [campagneId], references: [id], onDelete: Restrict)
  /// en_attente | en_cours | reussie | echouee
  statut               String             @default("en_attente")
  tentatives           Int                @default(0)
  maxTentatives        Int                @default(3)
  /// Date à partir de laquelle la tâche peut être (re)prise.
  prochaineTentativeLe DateTime?          @default(now())
  /// Prise en charge par le travailleur (détection des tâches interrompues).
  verrouilleeLe        DateTime?
  termineeLe           DateTime?
  erreur               String?
  /// Dernière exécution lancée pour cette tâche.
  executionId          String?
  execution            ExecutionWorkflow? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  creeLe               DateTime           @default(now())
  modifieLe            DateTime           @updatedAt

  @@unique([lotId, parcelleId])
  @@index([statut, prochaineTentativeLe])
}
