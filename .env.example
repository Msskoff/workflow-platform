# Copier ce fichier en `.env` à la racine du monorepo : il est lu par l'API et par le web.

# API Nest.js
API_PORT=3001
# Base SQLite (chemin relatif à apps/api)
DATABASE_URL=file:./prisma/dev.db
# Origine autorisée par CORS (le front)
WEB_ORIGIN=http://localhost:3000
# File des exécutions par lot : tâches traitées en parallèle, délai de la 1re relance (doublé ensuite)
LOTS_CONCURRENCE=2
LOTS_DELAI_RELANCE_MS=10000
# LOTS_TRAVAILLEUR=desactive

# Web Next.js : URL de l'API appelée côté serveur
API_URL=http://localhost:3001
